<?xml version="1.0" encoding="utf-8"?>
<!-- Ningún dato financiero sale del teléfono por copias automáticas de Google ni por transferencia entre dispositivos.
     Las copias se harán con el exportador cifrado propio de la app. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
